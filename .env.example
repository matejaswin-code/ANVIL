# ============================================================================
#  ANVIL — environment configuration
#
#  Copy this file to `.env` (the setup script does it for you) and edit.
#  Every value here has a working default, so ANVIL starts even if you change
#  nothing — it just runs on mock backends until you point it at real models.
#
#  Anything you set here can also be changed live in the Settings panel; the
#  panel does NOT write back to this file, so .env is your persistent baseline.
# ============================================================================


# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------

# Interface the local server binds to. Keep 127.0.0.1 unless you deliberately
# want other machines on your network to reach it — there is no auth layer.
ANVIL_HOST=127.0.0.1

# Port for the web UI and API. Change it if 8765 is already taken.
ANVIL_PORT=8765


# ----------------------------------------------------------------------------
# REASONING LLM
#
# Drives the checklist interview, style captioning, edit classification, and
# (in procedural mode) writes the bpy construction code.
# ----------------------------------------------------------------------------

# Which provider to use: lm_studio | openrouter | gemini
#   lm_studio  — fully local, no API key, occupies VRAM
#   openrouter — cloud, needs a key, frees local VRAM entirely
#   gemini     — cloud, needs a key, frees local VRAM entirely
LLM_PROVIDER=lm_studio

# OpenAI-compatible endpoint. Only used when LLM_PROVIDER=lm_studio.
# LM Studio's default local server address is below; start the server from
# LM Studio's "Developer" tab before running ANVIL.
LLM_ENDPOINT=http://127.0.0.1:1234/v1

# Model identifier.
#   lm_studio  -> whatever LM Studio reports (or just "local-model")
#   openrouter -> e.g. anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
#   gemini     -> e.g. gemini-2.0-flash
LLM_MODEL=local-model

# Set true only if the selected model can actually read images. When false,
# captioning a reference image fails immediately with a clear message rather
# than sending the image anyway and getting a confusing response back.
LLM_VISION_CAPABLE=true

# API keys — only needed for the matching provider. Leave blank otherwise.
# Get one at:  https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get one at:  https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ----------------------------------------------------------------------------
# 3D GENERATION BACKEND
#
# Turns an image (or text) into a raw mesh. This is the biggest VRAM consumer.
# ----------------------------------------------------------------------------

# Which backend: mock | trellis2_gguf | trellis2_full | hunyuan3d
#
#   mock           0 GB VRAM, CPU only, no weights needed. Produces a real .glb
#                  so the whole pipeline is testable before you download
#                  anything. This is the default on purpose.
#   trellis2_gguf  ~6 GB VRAM  — quantised, the practical choice on 8-12 GB cards
#   trellis2_full  ~11 GB VRAM — full precision, needs 12 GB+
#   hunyuan3d      ~9 GB VRAM
MODEL_BACKEND=mock

# Absolute path to a cloned TRELLIS repository.
# Required when MODEL_BACKEND is trellis2_gguf or trellis2_full.
#   git clone https://github.com/microsoft/TRELLIS
# Example: /home/you/models/TRELLIS   or   C:\models\TRELLIS
TRELLIS2_PATH=

# Absolute path to a cloned Hunyuan3D-2 repository.
# Required when MODEL_BACKEND=hunyuan3d.
#   git clone https://github.com/Tencent/Hunyuan3D-2
HUNYUAN3D_PATH=


# ----------------------------------------------------------------------------
# IMAGE GENERATION
#
# Only runs in Text→Image mode (pipeline step 5).
# ----------------------------------------------------------------------------

# Which backend: mock | comfyui | diffusers
#   mock       CPU, deterministic placeholder concept images, no weights
#   comfyui    talks to a ComfyUI instance you're already running
#   diffusers  loads a local diffusion model into VRAM directly
IMAGE_BACKEND=mock

# ComfyUI's HTTP address. Only used when IMAGE_BACKEND=comfyui.
# Start ComfyUI first; ANVIL ejects its own models before calling it so the two
# don't fight over the GPU.
COMFYUI_ENDPOINT=http://127.0.0.1:8188

# HuggingFace model id. Only used when IMAGE_BACKEND=diffusers. Weights download
# into models/hf/ inside this project on first use, not the global ~/.cache.
# Loaded fp16, so the model must publish an fp16 variant.
IMAGE_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# Output resolution, in pixels (square). Match the model's native training size:
# SDXL base is 1024, sdxl-turbo is 512. Generating far above native makes the model
# repeat structure — you get three trees where the prompt asked for one.
IMAGE_SIZE=1024

# Denoising steps and prompt adherence. These are model-specific, and wrong values
# degrade quietly rather than erroring:
#   SDXL base 1.0  -> IMAGE_STEPS=30  IMAGE_GUIDANCE=7.0
#   sdxl-turbo     -> IMAGE_STEPS=8   IMAGE_GUIDANCE=1.5  (distilled; more steps hurt)
IMAGE_STEPS=30
IMAGE_GUIDANCE=7.0


# ----------------------------------------------------------------------------
# RIGGING
# ----------------------------------------------------------------------------

# Absolute path to a cloned UniRig repository. Powers the [Rig this] button.
#   git clone https://github.com/VAST-AI-Research/UniRig
# Leave blank to disable rigging — the button then declines with an explanation
# instead of failing mid-run. There is deliberately no mock rigger: a fake
# skeleton would be worse than no skeleton.
UNIRIG_PATH=


# ----------------------------------------------------------------------------
# MESH POST-PROCESSING
# ----------------------------------------------------------------------------

# Absolute path to an AutoRemesher binary, used for quad remeshing.
#   https://github.com/huxingyi/autoremesher
# Optional. If it's missing, the remesh step is skipped and the mesh is flagged
# `unremeshed` rather than silently pretending it has clean quad topology.
AUTOREMESHER_PATH=


# ----------------------------------------------------------------------------
# BLENDER
# ----------------------------------------------------------------------------

# Absolute path to your Blender executable. Needed to import generated meshes
# into a scene, to apply property edits, and for procedural mode (which executes
# generated bpy code). Without it, meshes are still generated to disk and the UI
# tells you they weren't imported.
#
#   Linux:    /usr/bin/blender   or  /opt/blender/blender
#   macOS:    /Applications/Blender.app/Contents/MacOS/Blender
#   Windows:  C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
BLENDER_PATH=

# The .blend file ANVIL imports into. A relative path resolves inside the
# project directory. Created on first save if it doesn't exist.
BLEND_FILE=anvil_scene.blend


# ----------------------------------------------------------------------------
# CAPABILITY GUARD
# ----------------------------------------------------------------------------

# Below this much VRAM, ANVIL shows a one-time non-blocking warning at startup.
# It's a warning rather than a block because low VRAM may still work depending
# on which backend and quantisation you pick.
MIN_VRAM_WARNING_GB=8

# Set true to hard-block generation when no CUDA GPU is found. Keep it false to
# let the mock backends run on any machine.
REQUIRE_GPU=false


# ----------------------------------------------------------------------------
# LOOP CAPS
#
# Bound the two loops that could otherwise run forever.
# ----------------------------------------------------------------------------

# How many times the checklist interview may go back and forth before ANVIL
# offers to generate with whatever it has.
MAX_CHECKLIST_TURNS=10

# How many consecutive shape regenerations before ANVIL suggests adjusting the
# checklist instead — the prompt is usually where the leverage is.
MAX_REGENERATE_COUNT=10
